# vcpkg-harbor configuration template
#
# Copy this file to .env and replace every placeholder with a real value:
#   cp .env.example .env
#
# .env is ignored by git and must never be committed - it is the file that holds
# your real endpoints, keys and tokens. Only this template belongs in the
# repository, and it must only ever contain placeholders.
#
# Every value below can also be supplied as a plain environment variable, which
# is the preferred way to inject secrets in Docker/Kubernetes deployments.

# --------------------------------------------------------------------------
# Server settings (VCPKG_SERVER_*)
# --------------------------------------------------------------------------
VCPKG_SERVER_HOST=0.0.0.0
VCPKG_SERVER_PORT=15151
VCPKG_SERVER_WORKERS=4
# Auto-reload on code changes; development only
VCPKG_SERVER_RELOAD=false
# Reject uploads (mirror/consumer node)
VCPKG_SERVER_READ_ONLY=false
# Reject downloads (ingest-only node)
VCPKG_SERVER_WRITE_ONLY=false

# --------------------------------------------------------------------------
# Storage settings (VCPKG_STORAGE_*)
# --------------------------------------------------------------------------
# Options: filesystem, minio, s3, azure, gcs
VCPKG_STORAGE_TYPE=filesystem
# Local cache directory, used when VCPKG_STORAGE_TYPE=filesystem
VCPKG_STORAGE_PATH=./cache

# --------------------------------------------------------------------------
# MinIO settings (VCPKG_MINIO_*) - used when VCPKG_STORAGE_TYPE=minio
# --------------------------------------------------------------------------
VCPKG_MINIO_ENDPOINT=minio.example.com:9000
VCPKG_MINIO_ACCESS_KEY=replace-with-minio-access-key
VCPKG_MINIO_SECRET_KEY=replace-with-minio-secret-key
VCPKG_MINIO_BUCKET=vcpkg-harbor
# Use HTTPS to talk to MinIO; keep true for anything but a local sandbox
VCPKG_MINIO_SECURE=true
# Optional region, leave unset if your MinIO deployment does not use one
# VCPKG_MINIO_REGION=

# --------------------------------------------------------------------------
# AWS S3 settings (VCPKG_S3_*) - used when VCPKG_STORAGE_TYPE=s3
# --------------------------------------------------------------------------
# Prefer IAM roles / instance profiles over static keys where possible.
# VCPKG_S3_BUCKET=vcpkg-harbor
# VCPKG_S3_REGION=us-east-1
# VCPKG_S3_ACCESS_KEY_ID=replace-with-aws-access-key-id
# VCPKG_S3_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
# Custom endpoint for S3-compatible providers
# VCPKG_S3_ENDPOINT_URL=

# --------------------------------------------------------------------------
# Azure Blob settings (VCPKG_AZURE_*) - used when VCPKG_STORAGE_TYPE=azure
# --------------------------------------------------------------------------
# Either a connection string, or account name + account key.
# VCPKG_AZURE_CONNECTION_STRING=replace-with-azure-connection-string
# VCPKG_AZURE_ACCOUNT_NAME=replace-with-storage-account-name
# VCPKG_AZURE_ACCOUNT_KEY=replace-with-storage-account-key
# VCPKG_AZURE_CONTAINER=vcpkg-harbor

# --------------------------------------------------------------------------
# Google Cloud Storage settings (VCPKG_GCS_*) - used when VCPKG_STORAGE_TYPE=gcs
# --------------------------------------------------------------------------
# VCPKG_GCS_BUCKET=vcpkg-harbor
# VCPKG_GCS_PROJECT=replace-with-gcp-project-id
# Path to a service account JSON key file; keep it outside the repository
# VCPKG_GCS_CREDENTIALS_FILE=/run/secrets/gcs-service-account.json

# --------------------------------------------------------------------------
# Logging settings (VCPKG_LOG_*)
# --------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
VCPKG_LOG_LEVEL=INFO
VCPKG_LOG_JSON=false
VCPKG_LOG_FILE=logs/vcpkg-harbor.log
VCPKG_LOG_RETENTION_DAYS=30

# --------------------------------------------------------------------------
# Authentication settings (VCPKG_AUTH_*)
# --------------------------------------------------------------------------
VCPKG_AUTH_ENABLED=false
# Options: none, basic, token, oauth2
VCPKG_AUTH_TYPE=none
# For token auth - generate a long random value, e.g. `openssl rand -hex 32`
# VCPKG_AUTH_TOKEN=replace-with-a-long-random-token
# For basic auth - comma-separated user:password pairs
# VCPKG_AUTH_BASIC_USERS=replace-with-user:replace-with-password

# --------------------------------------------------------------------------
# Metrics settings (VCPKG_METRICS_*)
# --------------------------------------------------------------------------
VCPKG_METRICS_ENABLED=true
VCPKG_METRICS_PATH=/metrics

# --------------------------------------------------------------------------
# Dashboard settings (VCPKG_DASHBOARD_*)
# --------------------------------------------------------------------------
VCPKG_DASHBOARD_ENABLED=true
VCPKG_DASHBOARD_PATH=/
